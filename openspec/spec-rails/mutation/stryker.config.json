{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "_comment": "Spec-Rails Mutation Testing Rail for JS/TS (Stryker). Target: > 90% kill score; justify every survivor in the PR.",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "!src/index.ts"
  ],
  "testRunner": "jest",
  "reporters": ["progress", "clear-text"],
  "thresholds": {
    "high": 95,
    "low": 91,
    "break": 91
  },
  "concurrency": 4,
  "timeoutMS": 5000
}
