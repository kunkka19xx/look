<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LauncherApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:LauncherApp.Views"
    xmlns:commandPanels="using:LauncherApp.Views.CommandPanels"
    xmlns:settingsViews="using:LauncherApp.Views.Settings"
    mc:Ignorable="d"
    Title="look Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Border
        Margin="0"
        Padding="14"
        CornerRadius="16"
        Background="#29000000"
        BorderBrush="{StaticResource LauncherBorderBrush}"
        BorderThickness="1">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBox
                    x:Name="QueryInput"
                    Padding="34,10,12,10"
                    FontSize="14"
                    PlaceholderText="Search apps"
                    TextChanged="QueryInput_OnTextChanged"
                    KeyDown="QueryInput_OnKeyDown" />
                <TextBlock
                    Margin="12,0,0,0"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource LauncherMutedTextBrush}"
                    Text="&#xE721;"
                    IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="ResultsList"
                Background="Transparent"
                BorderThickness="0"
                IsItemClickEnabled="False"
                KeyDown="ResultsList_OnKeyDown"
                SelectionChanged="ResultsList_OnSelectionChanged"
                SelectionMode="Single">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#26364C" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2A3C55" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1D2A3A" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#2A3C55" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="0">
                            <Grid Padding="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top">
                                    <TextBlock
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource LauncherMutedTextBrush}"
                                        Text="{Binding IconGlyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource LauncherTextBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{StaticResource LauncherMutedTextBrush}"
                                        FontSize="11"
                                        Text="{Binding MetaLabel}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Rectangle
                                Height="1"
                                Fill="{StaticResource LauncherBorderBrush}"
                                Opacity="0.75"
                                Margin="6,0,6,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Rectangle
                x:Name="PreviewDivider"
                Grid.Column="1"
                Width="1"
                Fill="#263243"
                Visibility="Collapsed" />

            <views:ResultPreviewView
                x:Name="ResultPreviewPanel"
                Grid.Column="2"
                Visibility="Collapsed" />

            <commandPanels:CommandPanelsView
                x:Name="CommandPanelsPanel"
                Grid.Column="2"
                Visibility="Collapsed" />

            <settingsViews:SettingsTabsView
                x:Name="SettingsTabsPanel"
                Grid.Column="2"
                Visibility="Collapsed" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="3">
                <TextBlock
                    x:Name="HintText"
                    FontSize="11"
                    Foreground="{StaticResource LauncherMutedTextBrush}"
                    Text="Enter open  •  Ctrl+R reveal  •  Ctrl+C copy  •  Ctrl+Enter web" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
