{
  lib,
  rustPlatform,
  fetchurl,
  pkg-config,
  makeWrapper,
  libxkbcommon,
  xorg,
  wayland,
  vulkan-loader,
  libglvnd,
  alsa-lib,
  dbus,
  openssl,
  fontconfig,
  freetype,
  xdg-utils,
  curl,
  procps,
  glib,
}:

let
  # crates.io 403s its api/v1 download endpoint for the "curl/x.y Nixpkgs/z"
  # user agent fetchurl sends, so a source build dies on the first crate it
  # cannot substitute. static.crates.io serves the same tarballs unblocked, and
  # nixpkgs made that its default after this pin. Only the URL changes here, so
  # every store path stays identical and the Cachix cache keeps hitting.
  importCargoLock = rustPlatform.importCargoLock.override {
    fetchurl =
      args:
      fetchurl (
        args
        // {
          url =
            builtins.replaceStrings
              [ "https://crates.io/api/v1/crates" ]
              [ "https://static.crates.io/crates" ]
              args.url;
        }
      );
  };

  # Loaded at runtime, never linked: wgpu opens the Vulkan loader and GL,
  # gpui's Wayland client opens libwayland. An rpath keeps them out of the
  # environment of every app Look launches.
  runtimeLibs = [
    vulkan-loader
    libglvnd
    wayland
    libxkbcommon
    xorg.libxcb
  ];
in
rustPlatform.buildRustPackage {
  pname = "lookapp";
  version = (builtins.fromTOML (builtins.readFile ../../apps/linows/Cargo.toml)).workspace.package.version;

  src = lib.cleanSourceWith {
    src = ../..;
    filter =
      path: _type:
      let
        basePath = toString ../..;
        relPath = lib.removePrefix basePath (toString path);
      in
      (
        relPath == "/apps"
        || lib.hasPrefix "/apps/linows" relPath
        || lib.hasPrefix "/core" relPath
        || relPath == "/packaging"
        || lib.hasPrefix "/packaging/linux" relPath
      )
      # Prose sits inside the copied tree without being a build input. Without
      # this, editing a doc changes `src` and every consumer recompiles the
      # whole workspace for nothing.
      && !(lib.hasSuffix ".md" relPath);
  };

  cargoRoot = "apps/linows";
  # Vendor straight from the committed lockfile instead of a fixed-output
  # cargoHash. The hash had to be regenerated by hand on every Cargo.lock
  # change (e.g. Dependabot bumps), and a stale hash silently broke the Nix
  # build. importCargoLock derives the vendor from the lockfile itself, so it
  # stays correct automatically. Git dependencies are the one exception: each
  # needs its own hash here, regenerated when the pin moves with
  #   nix-prefetch-git --url <url> --rev <sha> --fetch-submodules
  cargoDeps = importCargoLock {
    lockFile = ../../apps/linows/Cargo.lock;
    outputHashes = {
      # [patch.crates-io] in apps/linows/Cargo.toml, the pipeline cache for gpui_ce_wgpu.
      "gpui_ce_wgpu-0.1.0" = "sha256-OXHAJT171ZLPDC0ZXL52eQsQJ8l2tFc3ey+5nc1SXYk=";
    };
  };

  buildAndTestSubdir = "apps/linows/gpui";

  # buildRustPackage runs `cargo test` by default, which recompiles the
  # workspace as test harnesses on top of the release build. `ci.yml` already
  # runs `cargo test --locked` for this same manifest on Linux, with a warm
  # cargo cache, so doing it again here only lengthens the Nix build.
  doCheck = false;

  nativeBuildInputs = [
    pkg-config
    makeWrapper
  ];

  buildInputs = [
    libxkbcommon
    xorg.libxcb
    xorg.libXau
    xorg.libXdmcp
    alsa-lib
    dbus
    openssl
    fontconfig
    freetype
  ];

  postFixup = ''
    patchelf --add-rpath ${lib.makeLibraryPath runtimeLibs} $out/bin/lookapp
    wrapProgram $out/bin/lookapp \
      --prefix PATH : ${lib.makeBinPath [
        xdg-utils
        fontconfig
        curl
        procps
        # gdbus backs the Wayland hotkey's D-Bus call, and is the first
        # caller wayland_shortcut.rs looks for.
        glib
      ]}
  '';

  postInstall = ''
    install -Dm644 $src/packaging/linux/lookapp.desktop \
      $out/share/applications/lookapp.desktop
    for size in 32 64 128; do
      install -Dm644 $src/apps/linows/icons/''${size}x''${size}.png \
        $out/share/icons/hicolor/''${size}x''${size}/apps/lookapp.png
    done
    install -Dm644 $src/apps/linows/icons/128x128@2x.png \
      $out/share/icons/hicolor/256x256/apps/lookapp.png
  '';

  meta = {
    description = "Keyboard-first desktop launcher";
    license = lib.licenses.gpl3Plus;
    platforms = lib.platforms.linux;
    mainProgram = "lookapp";
  };
}
